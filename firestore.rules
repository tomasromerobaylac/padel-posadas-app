rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isClubOwnerOf(clubId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // El propio usuario puede editar su perfil, pero no puede auto-otorgarse un rol.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
    }

    // Clubes: lectura pública para elegir uno al crear evento/publicación.
    // Escritura solo admin, o el club_owner vinculado a ese club puntual.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isClubOwnerOf(clubId);
      allow delete: if isAdmin();
    }

    // Cualquier usuario autenticado puede solicitar sumar su cancha; solo admin revisa.
    match /clubOwnerRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.requesterUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.organizerUserId == request.auth.uid;
      // El cupo (filledSlots/status) se actualiza vía transacción al anotarse; el organizador puede editar/cancelar.
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.organizerUserId == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false; // las bajas de cupo se resuelven con lógica de servidor a futuro
      }
    }

    match /courtPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.publishedByUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.publishedByUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.publishedByUserId == request.auth.uid;
    }

    match /friends/{userId}/list/{friendId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isOwner(friendId);
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }
  }
}
