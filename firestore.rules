rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isClubOwnerOf(clubId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUserId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // El propio usuario puede editar su perfil, pero no puede auto-otorgarse un rol.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
    }

    // Clubes: lectura pública para elegir uno al crear evento/publicación.
    // Escritura solo admin, o el club_owner vinculado a ese club puntual.
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isClubOwnerOf(clubId);
      allow delete: if isAdmin();
    }

    // Cualquier usuario autenticado puede solicitar sumar su cancha; solo admin revisa.
    // El id del documento es el propio userId: como máximo una solicitud activa por
    // cuenta, para que no se puedan mandar solicitudes fantasma en cadena.
    match /clubOwnerRequests/{requesterUserId} {
      allow read: if isAdmin() || (isSignedIn() && requesterUserId == request.auth.uid);
      allow create: if isSignedIn() && requesterUserId == request.auth.uid
        && request.resource.data.requesterUserId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Solo se puede reenviar (pisando el mismo doc) si la anterior fue rechazada.
      allow update: if isAdmin()
        || (isSignedIn() && requesterUserId == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.requesterUserId == request.auth.uid
            && request.resource.data.status == 'pending');
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.organizerUserId == request.auth.uid;
      // El cupo (filledSlots/status) se actualiza vía transacción al anotarse; el organizador puede editar/cancelar.
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.organizerUserId == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false; // las bajas de cupo se resuelven con lógica de servidor a futuro
      }

      // Chat entre los anotados a este partido puntual (organizador incluido).
      match /messages/{messageId} {
        function isEventParticipant() {
          let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
          return isSignedIn() && request.auth.uid in ev.participantUserIds;
        }

        allow read: if isEventParticipant();
        allow create: if isEventParticipant() && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /courtPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.publishedByUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.publishedByUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.publishedByUserId == request.auth.uid;
    }

    match /friends/{userId}/list/{friendId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) || isOwner(friendId);
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid && request.resource.data.status == 'pendiente';
      allow update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // Chat 1:1 entre un jugador y el dueño de un club (un solo hilo por club+jugador).
    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && (resource.data.ownerUserId == request.auth.uid || resource.data.playerUserId == request.auth.uid);
      }

      allow read: if isChatParticipant();
      allow create: if isSignedIn() && request.resource.data.playerUserId == request.auth.uid;
      allow update: if isChatParticipant();

      match /messages/{messageId} {
        function isThreadParticipant() {
          let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
          return isSignedIn() && (chat.ownerUserId == request.auth.uid || chat.playerUserId == request.auth.uid);
        }

        allow read: if isThreadParticipant();
        allow create: if isThreadParticipant() && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Mapa teléfono -> email para poder resolver el login por teléfono ANTES de
    // autenticarse (no se puede leer /users sin estar logueado). Solo guarda el
    // email, nada más sensible. Cada usuario solo puede escribir una entrada que
    // apunte a su propio email autenticado.
    match /phoneDirectory/{phone} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.data.email == request.auth.token.email;
    }

    // Chat 1:1 entre dos amigos.
    match /directChats/{chatId} {
      function isDirectParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isDirectParticipant();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isDirectParticipant();

      match /messages/{messageId} {
        function isDirectThreadParticipant() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participantIds;
        }

        allow read: if isDirectThreadParticipant();
        allow create: if isDirectThreadParticipant() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
